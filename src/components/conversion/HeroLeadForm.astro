---
interface Props {
  variant?: "dark" | "light"
  formContext?: string
  heading?: string
}

const {
  variant = "light",
  formContext = "hero-form",
  heading = "Get a free quote",
} = Astro.props

const isDark = variant === "dark"
---

<aside
  class={
    isDark
      ? "rounded-3xl bg-white/10 border border-white/20 px-5 py-5 md:px-6 md:py-6"
      : "rounded-3xl bg-white shadow-ps border border-ps-muted px-5 py-5 md:px-6 md:py-6"
  }
>
  <p
    class={`text-[11px] font-semibold tracking-[0.18em] uppercase ${isDark ? "text-white/60" : "text-ps-navy/60"}`}
  >
    Request a quote
  </p>
  <h2
    class={`mt-1 text-base font-semibold ${isDark ? "text-white" : "text-ps-navy"}`}
  >
    {heading}
  </h2>
  <p class={`mt-1 text-xs ${isDark ? "text-white/70" : "text-ps-navy/70"}`}>
    We respond same business day.
  </p>

  <form
    action="https://formspree.io/f/xpwkwgjl"
    method="POST"
    class="mt-4 space-y-3"
  >
    <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
    <input type="hidden" name="_next" value="/thank-you/" />
    <input type="hidden" name="_context" value={formContext} />

    <div>
      <label
        for={`hf-name-${formContext}`}
        class={`block text-[11px] font-semibold mb-1 ${isDark ? "text-white/80" : "text-ps-navy/80"}`}
      >
        Full name <span class="text-ps-red">*</span>
      </label>
      <input
        id={`hf-name-${formContext}`}
        type="text"
        name="name"
        required
        placeholder="Your name"
        class={`w-full rounded-lg border px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ps-red/40 ${
          isDark
            ? "bg-white/10 border-white/20 text-white placeholder-white/40"
            : "bg-white border-ps-muted text-ps-navy placeholder-ps-navy/40"
        }`}
      />
    </div>

    <div>
      <label
        for={`hf-phone-${formContext}`}
        class={`block text-[11px] font-semibold mb-1 ${isDark ? "text-white/80" : "text-ps-navy/80"}`}
      >
        Phone <span class="text-ps-red">*</span>
      </label>
      <input
        id={`hf-phone-${formContext}`}
        type="tel"
        name="phone"
        required
        placeholder="(619) 000-0000"
        class={`w-full rounded-lg border px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ps-red/40 ${
          isDark
            ? "bg-white/10 border-white/20 text-white placeholder-white/40"
            : "bg-white border-ps-muted text-ps-navy placeholder-ps-navy/40"
        }`}
      />
    </div>

    <div>
      <label
        for={`hf-email-${formContext}`}
        class={`block text-[11px] font-semibold mb-1 ${isDark ? "text-white/80" : "text-ps-navy/80"}`}
      >
        Email <span class="text-ps-red">*</span>
      </label>
      <input
        id={`hf-email-${formContext}`}
        type="email"
        name="email"
        required
        placeholder="you@email.com"
        class={`w-full rounded-lg border px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ps-red/40 ${
          isDark
            ? "bg-white/10 border-white/20 text-white placeholder-white/40"
            : "bg-white border-ps-muted text-ps-navy placeholder-ps-navy/40"
        }`}
      />
    </div>

    <div>
      <label
        for={`hf-project-${formContext}`}
        class={`block text-[11px] font-semibold mb-1 ${isDark ? "text-white/80" : "text-ps-navy/80"}`}
      >
        Project description
      </label>
      <input
        id={`hf-project-${formContext}`}
        type="text"
        name="project"
        placeholder="e.g. 24-unit HOA, replace CBUs"
        class={`w-full rounded-lg border px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ps-red/40 ${
          isDark
            ? "bg-white/10 border-white/20 text-white placeholder-white/40"
            : "bg-white border-ps-muted text-ps-navy placeholder-ps-navy/40"
        }`}
      />
    </div>

    <button
      type="submit"
      class="w-full rounded-full bg-ps-red py-2.5 text-sm font-semibold text-white shadow-md hover:bg-ps-red/90 transition"
    >
      Get a Free Quote →
    </button>
  </form>

  <p
    class={`mt-3 text-center text-[10px] font-semibold tracking-[0.12em] uppercase ${isDark ? "text-white/40" : "text-ps-navy/40"}`}
  >
    USPS-Approved · Licensed & Insured · San Diego County
  </p>
</aside>
