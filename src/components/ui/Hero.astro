---
import HeroLeadForm from "../conversion/HeroLeadForm.astro"

interface Props {
  variant?: "dark" | "light"
  eyebrow?: string
  heading: string
  subtext?: string
  bullets?: string[]
  primaryCta?: { href: string; label: string }
  secondaryCta?: { href: string; label: string; isPhone?: boolean }
  image?: { src: string; alt: string }
  showForm?: boolean
  formContext?: string
  formHeading?: string
}

const {
  variant = "light",
  eyebrow,
  heading,
  subtext,
  bullets,
  primaryCta,
  secondaryCta,
  image,
  showForm = false,
  formContext = "hero",
  formHeading,
} = Astro.props

const hasImage = !!image
const isDark = variant === "dark" || hasImage
const hasRightCol = showForm
---

<section
  class={[
    "relative bg-cover bg-center",
    hasImage ? "" : isDark ? "bg-ps-navy" : "bg-white border-b border-ps-muted",
  ].join(" ")}
  style={hasImage ? `background-image: url('${image.src}')` : undefined}
>
  {hasImage && <div class="absolute inset-0 bg-ps-navy/70"></div>}
  <div class="relative max-w-6xl mx-auto px-4 lg:px-6 py-10 lg:py-14">
    <div
      class={
        hasRightCol
          ? "grid gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] items-start"
          : "max-w-3xl"
      }
    >
      <!-- Left: text content -->
      <div>
        {eyebrow && (
          <p class="text-[11px] font-semibold tracking-[0.2em] uppercase text-white/70">
            {eyebrow}
          </p>
        )}

        <h1
          class={`${eyebrow ? "mt-2" : ""} text-3xl md:text-4xl font-semibold tracking-tight ${isDark ? "text-white" : "text-ps-navy"}`}
        >
          {heading}
        </h1>

        {subtext && (
          <p
            class={`mt-3 text-sm md:text-base max-w-xl ${isDark ? "text-white/80" : "text-ps-navy/80"}`}
          >
            {subtext}
          </p>
        )}

        {bullets && bullets.length > 0 && (
          <ul class={`mt-4 space-y-1.5 text-sm ${isDark ? "text-white/85" : "text-ps-navy/85"}`}>
            {bullets.map((item) => (
              <li>• {item}</li>
            ))}
          </ul>
        )}

        {(primaryCta || secondaryCta) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {primaryCta && (
              <a
                href={primaryCta.href}
                class="inline-flex items-center justify-center rounded-full bg-ps-red px-5 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-ps-red/90 transition"
              >
                {primaryCta.label}
              </a>
            )}
            {secondaryCta && (
              <a
                href={secondaryCta.href}
                {...secondaryCta.isPhone ? { "data-ga-event": "click_to_call", "data-ga-category": "Contact", "data-ga-label": "hero_phone" } : {}}
                class={
                  isDark
                    ? "inline-flex items-center justify-center rounded-full border border-white/70 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white hover:text-ps-navy transition"
                    : "inline-flex items-center justify-center rounded-full border border-ps-navy/20 bg-white px-5 py-2.5 text-sm font-semibold text-ps-navy hover:bg-ps-navy hover:text-white transition"
                }
              >
                {secondaryCta.label}
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Right: form -->
      {showForm && (
        <HeroLeadForm
          variant={variant}
          formContext={formContext}
          heading={formHeading}
        />
      )}
    </div>
  </div>
</section>
