---
import { buildServicePageSchema } from "../../../schema/service";
import { buildBreadcrumbSchema, appendBreadcrumbSchema } from "../../../schema/breadcrumb";
import SiteLayout from "../../../layouts/SiteLayout.astro"
import Breadcrumbs from "../../../components/Breadcrumbs.astro"
import Hero from "../../../components/ui/Hero.astro"
import SectionHeader from "../../../components/ui/SectionHeader.astro"
import TrustGrid from "../../../components/TrustGrid.astro"
import ProcessStrip from "../../../components/ProcessStrip.astro"
import { SERVICES_DATA, AREAS_DATA } from "../../../data/content"

type Area = {
  city: string
  state?: string
}

type Service = {
  name: string
  summary?: string
}

export async function getStaticPaths() {
  const areas = AREAS_DATA as Area[]
  const services = SERVICES_DATA as Service[]

  const paths: any[] = []

  for (const a of areas) {
    const cityName = a.city
    const state = a.state ?? "CA"

    const citySlug = String(cityName)
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "")

    for (const svc of services) {
      const serviceSlug = String(svc.name)
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "")

      paths.push({
        params: { city: citySlug, service: serviceSlug },
        props: {
          c: { city: cityName, state },
          s: svc,
        },
      })
    }
  }

  return paths
}

const { c, s } = Astro.props as {
  c: { city: string; state: string }
  s: Service
}

const citySlug = String(c.city)
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")

const serviceSlug = String(s.name)
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")

const serviceCity = `${s.name} in ${c.city}, ${c.state}`
const title = `${s.name} in ${c.city}, CA`

const cityServiceModules = import.meta.glob(
  "../../../data/city-service-content/*.json",
  { eager: true }
) as Record<string, any>

const cityServiceEntries = Object.values(cityServiceModules).map(
  (mod) => (mod as any).default
) as any[]

const cityFile = cityServiceEntries.find(
  (entry) => entry.serviceSlug === serviceSlug
)

const cityContent = cityFile?.cities?.[citySlug] ?? null

const baseDesc =
  s.summary ||
  `${s.name} by USPS-approved installers serving ${c.city}, ${c.state}.`
const desc = cityContent?.intro || baseDesc

const canonical = `https://sandiegocommercialmailboxes.com/service-areas/${citySlug}/${serviceSlug}/`

const breadcrumbSchema = buildBreadcrumbSchema([
  { label: "Home", href: "https://sandiegocommercialmailboxes.com/" },
  { label: "Service Areas", href: "https://sandiegocommercialmailboxes.com/service-areas/" },
  { label: c.city, href: `https://sandiegocommercialmailboxes.com/service-areas/${citySlug}/` },
  { label: s.name, href: canonical },
])

const serviceSchemas = buildServicePageSchema({
  name: s.name,
  description: desc,
  serviceUrl: canonical,
  areaServedCity: c.city,
  areaServedState: c.state,
})


const cityFaqs = (cityContent?.faqs ?? cityContent?.serviceSpecificFaqs) as { question: string; answer: string }[] | undefined
const faqSchemaObj = cityFaqs && cityFaqs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: cityFaqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    }
  : null

const baseSchemas = faqSchemaObj ? [...(Array.isArray(serviceSchemas) ? serviceSchemas : [serviceSchemas]), faqSchemaObj] : serviceSchemas
const pageSchema = appendBreadcrumbSchema(baseSchemas, breadcrumbSchema)

const allServices = SERVICES_DATA as {
  name: string
  summary?: string
}[]

const servicesContentModules = import.meta.glob(
  "../../../data/services-content/*.json",
  { eager: true }
) as Record<string, any>

const serviceContentMap = Object.fromEntries(
  Object.entries(servicesContentModules).map(([path, mod]) => {
    const slug = path.split("/").pop()?.replace(".json", "") ?? ""
    return [slug, (mod as any).default]
  })
) as Record<string, any>

const serviceContent = serviceContentMap[serviceSlug] ?? null

// Map service slug → image filename prefix for city-specific images
const serviceImgPrefix: Record<string, string> = {
  "commercial-mailbox-installation": "commercial-mailbox-installation",
  "cbu-installation": "cbu-mailbox-installation",
  "4c-wall-mounted-mailboxes": "4c-wall-mounted-mailboxes",
  "parcel-lockers": "parcel-locker-installation",
  "repairs-lock-changes": "mailbox-repairs-and-lock-changes",
  "ada-compliant-installs": "ada-compliant-mailbox-installation",
  "mailbox-replacement-retrofits": "mailbox-replacement-and-retrofits",
  "mailbox-relocation-consolidation": "commercial-mailbox-installation",
}

const prefix = serviceImgPrefix[serviceSlug]
const heroImage =
  cityContent?.heroImage ||
  serviceContent?.heroImage ||
  (prefix ? `/images/postal-systems/${prefix}-${citySlug}-ca.webp` : "")
const heroAlt =
  cityContent?.heroAlt ||
  serviceContent?.heroAlt ||
  `${s.name} in ${c.city}, ${c.state}`

const otherServices = allServices.filter((svc) => svc.name !== s.name)

export const prerender = true
---
<SiteLayout {title} description={desc} canonical={canonical} schema={pageSchema}>
  <Hero
    variant="light"
    eyebrow={`Mailbox services · ${c.city}, ${c.state}`}
    heading={serviceCity}
    subtext={`${desc} We coordinate layout, pads, anchors, tenant notices, and USPS inspections so your team does not have to.`}
    bullets={[
      `USPS-approved ${s.name.toLowerCase()} in ${c.city}.`,
      "Pads, anchors, ADA-compliant layouts, and inspection sign-off.",
      "Serving HOAs, apartments, builders, and commercial properties.",
      `Trusted contractor across ${c.city} and San Diego County.`,
    ]}
    primaryCta={{ href: "/contact/", label: "Get a free quote" }}
    secondaryCta={{ href: "tel:16194614787", label: "Call (619) 461-4787", isPhone: true }}
    showForm={true}
    image={heroImage ? { src: heroImage, alt: heroAlt } : undefined}
    formContext={`money-hero-${citySlug}-${serviceSlug}`}
  />
  <main class="max-w-6xl mx-auto px-4 lg:px-6 py-10 lg:py-12">
    <Breadcrumbs
      crumbs={[
        { href: "/", label: "Home" },
        { href: "/service-areas/", label: "Service Areas" },
        { href: `/service-areas/${citySlug}/`, label: c.city },
        { href: canonical, label: s.name },
      ]}
    />

    {cityContent?.sections && cityContent.sections.length > 0 && (
      <section class="mt-10 space-y-10 max-w-3xl">
        {cityContent.sections.map((block: any) => (
          <article id={block.id} class="space-y-3">
            <h2 class="text-xl md:text-2xl font-semibold text-ps-navy">
              {block.heading}
            </h2>
            {block.body && (
              <p class="text-sm md:text-base text-ps-navy/85">
                {block.body}
              </p>
            )}
            {block.bullets && block.bullets.length > 0 && (
              <ul class="mt-2 space-y-1.5 text-sm text-ps-navy/85">
                {block.bullets.map((item: string) => (
                  <li class="flex gap-2">
                    <span class="mt-1 h-1.5 w-1.5 rounded-full bg-ps-red"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
            {block.closing && (
              <p class="mt-2 text-sm md:text-base text-ps-navy/85">
                {block.closing}
              </p>
            )}
          </article>
        ))}
      </section>
    )}


    {(cityContent?.localUseCases || cityContent?.propertyTypes || cityContent?.commonTriggers || cityContent?.scopeDetails || cityContent?.complianceNotes || cityContent?.projectSignals || cityContent?.decisionFactors || cityContent?.internalLinkNotes) && (
      <section class="mt-10 grid gap-4 md:grid-cols-2">
        {cityContent?.localUseCases?.length > 0 && (
          <article class="rounded-2xl border border-ps-muted bg-white p-5 shadow-ps">
            <h2 class="text-base font-semibold text-ps-navy">Common local use cases</h2>
            <ul class="mt-3 space-y-1.5 text-sm text-ps-navy/85">{cityContent.localUseCases.map((item: string) => <li>• {item}</li>)}</ul>
          </article>
        )}
        {cityContent?.propertyTypes?.length > 0 && (
          <article class="rounded-2xl border border-ps-muted bg-white p-5 shadow-ps">
            <h2 class="text-base font-semibold text-ps-navy">Property types we support</h2>
            <ul class="mt-3 space-y-1.5 text-sm text-ps-navy/85">{cityContent.propertyTypes.map((item: string) => <li>• {item}</li>)}</ul>
          </article>
        )}
        {cityContent?.commonTriggers?.length > 0 && (
          <article class="rounded-2xl border border-ps-muted bg-white p-5 shadow-ps">
            <h2 class="text-base font-semibold text-ps-navy">What usually triggers this project</h2>
            <ul class="mt-3 space-y-1.5 text-sm text-ps-navy/85">{cityContent.commonTriggers.map((item: string) => <li>• {item}</li>)}</ul>
          </article>
        )}
        {cityContent?.scopeDetails?.length > 0 && (
          <article class="rounded-2xl border border-ps-muted bg-white p-5 shadow-ps">
            <h2 class="text-base font-semibold text-ps-navy">Typical scope details</h2>
            <ul class="mt-3 space-y-1.5 text-sm text-ps-navy/85">{cityContent.scopeDetails.map((item: string) => <li>• {item}</li>)}</ul>
          </article>
        )}
        {cityContent?.complianceNotes?.length > 0 && (
          <article class="rounded-2xl border border-ps-muted bg-white p-5 shadow-ps md:col-span-2">
            <h2 class="text-base font-semibold text-ps-navy">Compliance notes</h2>
            <ul class="mt-3 space-y-1.5 text-sm text-ps-navy/85">{cityContent.complianceNotes.map((item: string) => <li>• {item}</li>)}</ul>
          </article>
        )}
        {cityContent?.projectSignals?.length > 0 && (
          <article class="rounded-2xl border border-ps-muted bg-white p-5 shadow-ps md:col-span-2">
            <h2 class="text-base font-semibold text-ps-navy">Project planning signals</h2>
            <ul class="mt-3 space-y-1.5 text-sm text-ps-navy/85">{cityContent.projectSignals.map((item: string) => <li>• {item}</li>)}</ul>
          </article>
        )}
        {cityContent?.decisionFactors?.length > 0 && (
          <article class="rounded-2xl border border-ps-muted bg-white p-5 shadow-ps md:col-span-2">
            <h2 class="text-base font-semibold text-ps-navy">Decision factors owners and managers compare</h2>
            <ul class="mt-3 space-y-1.5 text-sm text-ps-navy/85">{cityContent.decisionFactors.map((item: string) => <li>• {item}</li>)}</ul>
          </article>
        )}
      </section>
    )}

    {cityContent?.serviceSpecificFaqs && cityContent.serviceSpecificFaqs.length > 0 && (
      <section class="mt-10">
        <SectionHeader title={`Service-specific questions in ${c.city}`} subtitle="Extra planning questions from property managers, HOAs, and builder teams." align="left" />
        <div class="mt-4 space-y-3">
          {cityContent.serviceSpecificFaqs.map((faq: any) => (
            <details class="group rounded-2xl border border-ps-muted bg-white p-4 shadow-ps">
              <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ps-navy"><span>{faq.question}</span></summary>
              <p class="mt-2 text-xs text-ps-navy/80">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {cityContent?.faqs && cityContent.faqs.length > 0 && (
      <section class="mt-10">
        <SectionHeader
          title={`FAQs about ${s.name.toLowerCase()} in ${c.city}`}
          subtitle="Questions we regularly hear from boards, managers, and owners in this area."
          align="left"
        />
        <div class="mt-4 space-y-3">
          {cityContent.faqs.map((faq: any) => (
            <details class="group rounded-2xl border border-ps-muted bg-white p-4 shadow-ps">
              <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ps-navy">
                <span>{faq.question}</span>
                <span class="ml-3 text-xs text-ps-navy/60 group-open:hidden">+</span>
                <span class="ml-3 text-xs text-ps-navy/60 hidden group-open:inline">−</span>
              </summary>
              <p class="mt-2 text-xs text-ps-navy/80">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    {cityContent?.nearbyAreas && cityContent.nearbyAreas.length > 0 && (
      <section class="mt-10">
        <SectionHeader
          title="Nearby areas we serve for this service"
          subtitle="If you manage multiple properties, we can coordinate projects across neighboring communities."
          align="left"
        />
        <ul class="mt-4 flex flex-wrap gap-2 text-xs">
          {cityContent.nearbyAreas.map((area: any) => (
            <li>
              <a
                href={area.url}
                class="inline-flex items-center rounded-full border border-ps-muted bg-white px-3 py-1 text-ps-navy hover:text-ps-red hover:border-ps-red/60"
              >
                {area.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {otherServices.length > 0 && (
      <section class="mt-10">
        <SectionHeader
          title={`Other mailbox services in ${c.city}`}
          subtitle="We handle a full range of mailbox projects for local communities and properties."
          align="left"
        />
        <ul class="mt-4 grid gap-4 md:grid-cols-2 text-sm">
          {otherServices.map((svc) => {
            const otherSlug = String(svc.name)
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/(^-|-$)/g, "")
            return (
              <li>
                <a
                  href={`/service-areas/${citySlug}/${otherSlug}/`}
                  class="block rounded-2xl border border-ps-muted bg-white px-4 py-3 text-ps-navy hover:border-ps-red/60 hover:text-ps-red"
                >
                  <div class="text-sm font-semibold">{svc.name}</div>
                  {svc.summary && (
                    <div class="mt-1 text-[11px] text-ps-navy/70">
                      {svc.summary}
                    </div>
                  )}
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    )}

    <section class="mt-10">
      <TrustGrid />
    </section>

    <section class="mt-10">
      <ProcessStrip />
    </section>
  </main>
</SiteLayout>
